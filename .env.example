# Copy this file to .env and set the path to your SSH public key.
# The key is injected into the coral-ssh-slurm container at runtime.
SSH_PUB_KEY_PATH=~/.ssh/id_ed25519.pub

# Host ports of the SSH server (coral-ssh-slurm) and of the visualizer.
# Change them to run this stack next to another one using the same defaults,
# such as the dealii-X tutorial stack; set the same values in the app Settings.
# CORAL_SSH_PORT=2222
# VISUALIZER_PORT=8008
