{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/2listic/dealiiX-platform/schemas/v1.1/common.schema.json",
  "title": "common",
  "description": "Definitions shared by the registry and network schemas.",
  "$defs": {
    "nodeType": {
      "description": "Rendering hint for a node. Backends identify a node by its `type`, never by `node_type`.",
      "enum": [
        "elementary_constructor",
        "primitive",
        "empty_constructor",
        "constructor",
        "abstract",
        "output_only",
        "method",
        "const_method",
        "void_method",
        "void_const_method",
        "function",
        "void_function",
        "network"
      ]
    },
    "argument": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "connection_type": {
          "enum": ["input", "output", "pass_through"]
        },
        "multiple": { "type": "boolean" },
        "configuration_path": {
          "description": "For a configuration output, the path of the scalar value in the source node's configuration.",
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "base": {
          "type": "string",
          "minLength": 1
        },
        "bases": {
          "$ref": "#/$defs/typeList"
        }
      },
      "required": ["name", "type", "connection_type"],
      "dependentSchemas": {
        "configuration_path": {
          "properties": { "connection_type": { "const": "output" } }
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "description": "Indices into `arguments`, one per input port.",
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "uniqueItems": true
    },
    "outputs": {
      "description": "Indices into `arguments`, one per output port; -1 is the node itself (SELF).",
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -1
      },
      "uniqueItems": true
    },
    "typeList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "qualifiedId": {
      "description": "Hierarchical node id, `<parent>_<child>` for nested nodes. It names the node's status files (`<qualified_id>.running`), so it never contains `.`, `/` or `\\`.",
      "type": "string",
      "pattern": "^[^./\\\\]+$"
    },
    "position": {
      "description": "Canvas position written by the editor.",
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": ["x", "y"],
      "additionalProperties": false
    },
    "parameterFile": {
      "description": "Editor metadata marking a string literal as a parameter file. Each exposure is a parameter port; materialization writes bound inputs into a run copy of the file and removes this metadata before launch.",
      "type": "object",
      "properties": {
        "exposures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "description": "Section names followed by the entry name.",
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "type": {
                "enum": ["string", "int", "unsigned int", "double", "bool"]
              },
              "input": {
                "type": "boolean"
              },
              "output": {
                "type": "boolean"
              }
            },
            "required": ["path", "type", "input", "output"],
            "additionalProperties": false
          }
        }
      },
      "required": ["exposures"],
      "additionalProperties": false
    },
    "plugin": {
      "description": "Initialization object passed unchanged to the backend plugin. CORAL reads `MPI.enabled`; the deal.II plugin also reads `MPI.args` and `MPI.max_num_threads`. Other keys belong to the plugin.",
      "type": "object",
      "properties": {
        "MPI": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_num_threads": {
              "type": "integer",
              "minimum": 0
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "backendIdentity": {
      "description": "Names a backend and its plugins independently of installation paths.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "plugin": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["id"],
            "additionalProperties": false
          }
        }
      },
      "required": ["id"]
    },
    "registryDigest": {
      "description": "SHA-256 digest. Protocol 1.1 hashes the RFC 8785 canonical JSON representation.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "registryBackend": {
      "description": "Header a backend writes under the registry's `__backend` key.",
      "$ref": "#/$defs/backendIdentity",
      "properties": {
        "configuration": { "$ref": "parameters.schema.json" },
        "capabilities": { "$ref": "registry.schema.json#/$defs/capabilities" },
        "registry_digest": {
          "$ref": "#/$defs/registryDigest"
        },
        "configuration_digest": { "$ref": "#/$defs/registryDigest" },
        "operations": {
          "description": "Operations the backend supports. A backend that lists `migrate` can upgrade a network built against an older registry.",
          "type": "array",
          "items": {
            "enum": [
              "register",
              "describe",
              "configure",
              "validate",
              "run",
              "submit",
              "status",
              "logs",
              "outputs",
              "cancel",
              "pause",
              "resume",
              "replay",
              "artifact",
              "migrate"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": ["id"],
      "if": {
        "anyOf": [
          { "required": ["version"] },
          { "required": ["operations"] },
          { "required": ["plugins"] },
          { "required": ["registry_digest"] }
        ]
      },
      "then": { "required": ["version", "registry_digest", "operations"] },
      "unevaluatedProperties": false
    },
    "networkBackend": {
      "description": "Header naming the backend a network targets. With `registry_digest`, the backend rejects the network as stale when its current registry differs; without it, `version` must match when given.",
      "$ref": "#/$defs/backendIdentity",
      "properties": {
        "registry_digest": {
          "$ref": "#/$defs/registryDigest"
        }
      },
      "unevaluatedProperties": false
    }
  }
}
