{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/2listic/dealiiX-platform/schemas/desktop/frontend-settings.schema.json",
  "title": "Frontend settings",
  "description": "Local desktop preferences, stored as a deal.II JSON parameter tree.",
  "type": "object",
  "properties": {
    "Backend command": {
      "$ref": "https://github.com/2listic/dealiiX-platform/schemas/v1.1/parameters.schema.json#/$defs/leaf"
    },
    "Backend configuration file": {
      "$ref": "https://github.com/2listic/dealiiX-platform/schemas/v1.1/parameters.schema.json#/$defs/leaf"
    },
    "Theme": {
      "allOf": [
        {
          "$ref": "https://github.com/2listic/dealiiX-platform/schemas/v1.1/parameters.schema.json#/$defs/leaf"
        },
        { "properties": { "value": { "enum": ["auto", "light", "dark"] } } }
      ]
    },
    "VTK visualizer URL": {
      "$ref": "https://github.com/2listic/dealiiX-platform/schemas/v1.1/parameters.schema.json#/$defs/leaf"
    },
    "Project server URL": {
      "$ref": "https://github.com/2listic/dealiiX-platform/schemas/v1.1/parameters.schema.json#/$defs/leaf"
    }
  },
  "required": [
    "Backend command",
    "Backend configuration file",
    "Theme",
    "VTK visualizer URL",
    "Project server URL"
  ],
  "additionalProperties": false
}
