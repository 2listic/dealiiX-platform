{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/2listic/dealiiX-platform/main/schemas/registry.schema.json",
  "title": "registry",
  "description": "Node definitions a backend offers, keyed by `type`; a library of stored network nodes is keyed by `name`. Keys starting with `__` carry registry metadata.",
  "type": "object",
  "properties": {
    "__backend": {
      "$ref": "common.schema.json#/$defs/registryBackend"
    },
    "__backend_name": {
      "description": "Backend name CORAL writes when its registry header is switched on.",
      "type": "string"
    }
  },
  "propertyNames": {
    "anyOf": [
      {
        "enum": ["__backend", "__backend_name"]
      },
      {
        "not": {
          "pattern": "^__"
        }
      }
    ]
  },
  "additionalProperties": {
    "$ref": "#/$defs/definition"
  },
  "$defs": {
    "definition": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "node_type": {
          "$ref": "common.schema.json#/$defs/nodeType"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/argument"
          }
        },
        "inputs": {
          "$ref": "common.schema.json#/$defs/inputs"
        },
        "outputs": {
          "$ref": "common.schema.json#/$defs/outputs"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "description": "Default literal, stored workflow, or embedded registry of a backend node."
        },
        "display_name": {
          "type": "string"
        },
        "variant_name": {
          "type": "string"
        },
        "overload_group": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "class_name": {
          "type": "string"
        },
        "method_name": {
          "type": "string"
        },
        "output_type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "base": {
          "description": "Single base type written by older CORAL releases.",
          "type": "string",
          "minLength": 1
        },
        "bases": {
          "$ref": "common.schema.json#/$defs/typeList"
        },
        "derived": {
          "$ref": "common.schema.json#/$defs/typeList"
        },
        "configuration": {
          "description": "Template of the node's parameter document. A node instance starts from it and carries its own copy.",
          "$ref": "parameters.schema.json"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "x-dealiix": {
          "$ref": "#/$defs/extension"
        }
      },
      "required": ["type", "node_type", "arguments", "inputs", "outputs"],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["coral::Network", "network::coral"]
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "node_type": {
                "const": "network"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "node_type": {
                "const": "network"
              }
            },
            "required": ["node_type"]
          },
          "then": {
            "properties": {
              "value": {
                "anyOf": [
                  {
                    "type": "object",
                    "maxProperties": 0
                  },
                  {
                    "$ref": "network.schema.json"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "registry": { "$ref": "#" }
                    },
                    "required": ["registry"],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": { "enum": ["open_child_workflow", "configure"] },
          "uniqueItems": true
        },
        "configuration_exposable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "extension": {
      "description": "Draft editor and execution metadata of a node definition.",
      "type": "object",
      "properties": {
        "actions": {
          "description": "Editor actions the node supports: entering its child workflow, editing its `configuration`.",
          "type": "array",
          "items": {
            "enum": ["open_child_workflow", "configure"]
          },
          "uniqueItems": true
        },
        "execution": {
          "type": "object",
          "properties": {
            "kind": {
              "description": "`in_process`: the backend runs the node itself. `executable`: the backend launches an external program. `child_workflow`: the node's `value` is a workflow the backend runs, or hands to the backend its header names.",
              "enum": ["in_process", "executable", "child_workflow"]
            },
            "target": {
              "enum": ["local", "remote", "any"]
            },
            "parallelism": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": ["serial", "mpi"]
                },
                "processes": {
                  "type": "integer",
                  "minimum": 1
                },
                "processes_from": {
                  "description": "Name of the input argument holding the process count.",
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["mode"],
              "additionalProperties": false
            },
            "run_policy": {
              "enum": ["always", "if_outputs_missing_or_inputs_changed"]
            }
          },
          "required": ["kind"],
          "additionalProperties": false
        },
        "files": {
          "type": "object",
          "properties": {
            "inputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fileInput"
              }
            },
            "outputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fileOutput"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fileInput": {
      "description": "An input argument whose value is a file path. The backend places the file before the node runs.",
      "type": "object",
      "properties": {
        "argument": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "$ref": "#/$defs/mediaType"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": ["argument", "media_type"],
      "additionalProperties": false
    },
    "fileOutput": {
      "description": "A file the node produces, named by an argument or by a path relative to the run directory.",
      "type": "object",
      "properties": {
        "argument": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "$ref": "#/$defs/mediaType"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "must_exist_after_success": {
          "type": "boolean"
        }
      },
      "required": ["media_type"],
      "oneOf": [
        {
          "required": ["argument"]
        },
        {
          "required": ["path"]
        }
      ],
      "additionalProperties": false
    },
    "mediaType": {
      "type": "string",
      "pattern": "^[a-z]+/[^\\s]+$"
    }
  }
}
