#!/usr/bin/env python3
"""Run dealiiX workflows against configured CORAL plugins and executables."""

import argparse
import base64
import json
import mimetypes
import re
import shutil
import signal
import subprocess
import sys
import uuid
from dataclasses import asdict
from pathlib import Path

try:
    from execution import Machine, discover, execute, materialize, stage_argv, stopped
    from file_artifacts import (
        check_inputs,
        check_output_names,
        resolve_references,
        stage_directory,
    )
    from scheduling import change_scheduling, initialize_scheduling, scheduling_status
    from protocol import (
        Error,
        FileBinding,
        SELECTION_TYPE,
        Stage,
        Target,
        VERSION,
        WORKFLOW_OPERATIONS,
        check,
        configuration,
        describe,
        diagnostic,
        digest,
        encode,
        migrate,
        plan,
        read,
        values,
        write,
    )
except ModuleNotFoundError as error:
    sys.exit(
        json.dumps(
            {
                "error": {
                    "code": "missing_dependency",
                    "message": f"{error}. Install tools/orchestrator/requirements.txt in the Python environment.",
                }
            }
        )
    )


RUN_ID = re.compile(r"run-[a-f0-9]{32}")
TERMINAL = {"succeeded", "failed", "cancelled"}
ARTIFACT_CHUNK = 1024 * 1024
READ_ARTIFACT = """
import sys
from pathlib import Path
path, root = map(Path, sys.argv[1:3])
if not path.is_file() or path.is_symlink() or not path.resolve().is_relative_to(root.resolve()):
    sys.exit('Artifact is not a regular file within the execution directory')
with path.open('rb') as stream:
    stream.seek(int(sys.argv[3]))
    sys.stdout.buffer.write(stream.read(int(sys.argv[4])))
"""


class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise Error("invalid_arguments", message)


def parser():
    result = Parser(description=__doc__)
    result.add_argument("--configuration", "-p", "--plugin", metavar="FILE", type=Path)
    commands = result.add_subparsers(dest="operation", required=True)
    register = commands.add_parser("register")
    register.add_argument("--registry-path", type=Path, default=Path("node_types.json"))
    commands.add_parser("exchange", help="Read one JSON request and write one JSON response")
    commands.add_parser("validate").add_argument("network", type=Path)
    for operation in ("run", "submit"):
        command = commands.add_parser(operation)
        command.add_argument("network", type=Path)
        command.add_argument("--touch-dir", type=Path)
    for operation in ("status", "cancel", "pause", "resume", "outputs", "logs", "replay"):
        command = commands.add_parser(operation)
        command.add_argument("run_id")
        if operation == "logs":
            command.add_argument("qualified_id", nargs="?")
    worker = commands.add_parser("_worker", help=argparse.SUPPRESS)
    worker.add_argument("directory", type=Path)
    return result


def registry_for(config):
    return describe(
        config, {key: discover(target) for key, target in config.targets.items()}
    )


def preparation(document, config, registry):
    network, stages, parents, native_registries, occupied = plan(
        document, config, registry, discover
    )
    artifacts = {}
    verified_inputs = set()
    for key, stage in stages.items():
        verified_inputs.update(check_inputs(stage, Machine(stage.target)))
        files = materialize(stage, native_registries.get(key), occupied)
        check_output_names(stage, files)
        preview_id = "run-preview"
        resolve_references(
            stage,
            files,
            stage_argv(stage, stage_directory(stage, preview_id)),
            preview_id,
        )
        artifacts[key] = files
    return network, stages, parents, artifacts, verified_inputs


def new_run(config, network, stages, parents, artifacts, verified_inputs, touch):
    run = allocate_run(config.runs_directory)
    if touch is not None:
        touch = touch.resolve()
        touch.mkdir(parents=True, exist_ok=True)
    write(run / "network.json", network)
    write(run / "backend.config.json", config.tree)
    write(
        run / "plan.json",
        {
            "stages": {key: asdict(stage) for key, stage in stages.items()},
            "parents": {key: sorted(items) for key, items in parents.items()},
            "verified_inputs": sorted(verified_inputs),
            "selections": [
                item["qualified_id"]
                for item in network["workflow"]["nodes"].values()
                if item["type"] == SELECTION_TYPE
            ],
            "touch": str(touch) if touch is not None else None,
        },
    )
    effective = run / "effective"
    effective.mkdir()
    for key, files in artifacts.items():
        directory = effective / key
        directory.mkdir()
        for filename, contents in files.items():
            (directory / filename).write_text(contents, encoding="utf-8")
    write(run / "state.json", {"run_id": run.name, "state": "queued"})
    return run


def allocate_run(directory):
    run = directory / f"run-{uuid.uuid4().hex}"
    run.mkdir(parents=True, mode=0o700)
    (run / "status").mkdir()
    initialize_scheduling(run)
    return run


def new_replay(source):
    if read(source / "state.json")["state"] != "succeeded":
        raise Error("replay_unavailable", "Replay requires a successful run")
    plan = read(source / "plan.json")
    expected = {}
    for stage in plan["stages"].values():
        qid = stage["qid"]
        fingerprint = read(source / qid / "state.json").get("fingerprint")
        if fingerprint is None:
            raise Error("replay_unavailable", f"{qid}: the source run has no recorded fingerprint")
        expected[qid] = fingerprint
    run = allocate_run(source.parent)
    for filename in ("network.json", "backend.config.json"):
        shutil.copyfile(source / filename, run / filename)
    shutil.copytree(source / "effective", run / "effective")
    write(run / "plan.json", {
        **plan, "touch": None, "verified_inputs": [],
        "expected_fingerprints": expected, "source_run_id": source.name,
    })
    write(run / "state.json", {"run_id": run.name, "state": "queued", "source_run_id": source.name})
    return run


def worker(run):
    state = {**read(run / "state.json"), "state": "running"}
    write(run / "state.json", state)

    def cancel(_signal, _frame):
        (run / "cancel").touch()

    signal.signal(signal.SIGINT, cancel)
    signal.signal(signal.SIGTERM, cancel)
    try:
        snapshot = read(run / "plan.json")
        stages = {}
        artifacts = {}
        for key, data in snapshot["stages"].items():
            data["target"] = Target(**data["target"])
            for direction in ("inputs", "outputs"):
                data[direction] = {
                    name: FileBinding(
                        **{
                            **binding,
                            "target": Target(**binding["target"])
                            if binding.get("target")
                            else None,
                        }
                    )
                    for name, binding in data.get(direction, {}).items()
                }
            stages[key] = Stage(**data)
            artifacts[key] = {
                path.name: path.read_text(encoding="utf-8")
                for path in (run / "effective" / key).iterdir()
            }
        touches = [run / "status"]
        if snapshot["touch"] is not None:
            touches.append(Path(snapshot["touch"]))
        results = execute(
            stages, snapshot["parents"], artifacts, run, touches,
            snapshot.get("expected_fingerprints", {}),
        )
        if stopped(run):
            state["state"] = "cancelled"
        elif all(result == "succeeded" for result in results.values()):
            state["state"] = "succeeded"
        else:
            incomplete = [
                stages[key].qid
                for key, result in results.items()
                if result != "succeeded"
            ]
            details = []
            for qid in incomplete:
                error = read(run / qid / "state.json").get("error")
                if error:
                    details.append(error["message"])
            message = "Nodes that did not complete: " + ", ".join(incomplete)
            state.update(
                state="failed",
                error={"code": "run_failed", "message": "\n".join([message, *details])},
            )
    except Exception as error:  # noqa: BLE001 - a detached worker must leave a terminal record.
        state.update(state="failed", error=diagnostic(error, "execution_error"))
    write(run / "state.json", state)
    return status(run)


def find_run(config, run_id):
    if not RUN_ID.fullmatch(run_id):
        raise Error("unknown_run", f"Invalid run id {run_id!r}")
    run = config.runs_directory / run_id
    if not (run / "state.json").is_file():
        raise Error("unknown_run", f"Run {run_id} does not exist")
    return run


def status(run):
    state = read(run / "state.json")
    snapshot = read(run / "plan.json")
    verified = set(snapshot.get("verified_inputs", ()))
    terminal = state["state"] in TERMINAL
    scheduling = scheduling_status(run) if not terminal else None
    if (run / "cancel").is_file() and not terminal:
        state["cancellation_requested"] = True
    elif scheduling is not None:
        state["scheduling"] = scheduling
    nodes = {
        qid: {"qualified_id": qid, "state": "succeeded"}
        for qid in snapshot.get("selections", ())
    }
    state["nodes"] = nodes

    # A runtime check may fail after the same file passed an earlier check.
    phases = {"queued": 0, "running": 1, "cancelled": 2, "succeeded": 3, "failed": 4}
    for marker in (run / "status").iterdir():
        qid, _, phase = marker.name.rpartition(".")
        if not qid or phase not in phases:
            continue
        if qid not in nodes or phases[phase] > phases[nodes[qid]["state"]]:
            nodes[qid] = {"qualified_id": qid, "state": phase}
    file_errors = {}
    for data in snapshot["stages"].values():
        qid = data["qid"]
        path = run / qid / "state.json"
        record = (
            read(path)
            if path.is_file()
            else {
                "qualified_id": qid,
                "state": "queued",
            }
        )
        nodes[qid] = record
        for binding in data.get("inputs", {}).values():
            file_id = binding["qid"]
            if terminal and binding["optional"] and file_id not in verified:
                continue
            nodes.setdefault(file_id, {
                "qualified_id": file_id,
                "state": "succeeded" if file_id in verified else "queued",
            })
        for binding in data.get("outputs", {}).values():
            file_id = binding["qid"]
            if terminal and binding["optional"]:
                continue
            file_node = nodes.setdefault(file_id, {"qualified_id": file_id, "state": "queued"})
            if file_node["state"] == "queued" and record["state"] == "running":
                file_node["state"] = "running"
        error = record.get("error", {})
        if record["state"] == "failed" and "qualified_id" in error:
            file_errors[error["qualified_id"]] = error
    for file_id, error in file_errors.items():
        nodes[file_id] = {"qualified_id": file_id, "state": "failed", "error": error}
    return state


def inspect_run(run, operation, qid=None):
    if operation in {"pause", "resume"}:
        change_scheduling(run, operation == "pause", TERMINAL)
        return status(run)
    result = status(run)
    if operation == "status":
        return result
    if operation == "cancel":
        if result["state"] not in TERMINAL:
            (run / "cancel").touch()
        return status(run)
    entries = read(run / "plan.json")["stages"].values()
    stages = {data["qid"]: Target(**data["target"]) for data in entries}
    if qid is not None and qid not in stages:
        raise Error("unknown_node", f"No execution node with qualified_id {qid!r}")
    response = {}
    for key, target in stages.items():
        if qid is not None and qid != key:
            continue
        node = result["nodes"][key]
        directory = node.get("directory")
        if not directory:
            continue
        machine = Machine(target)
        if operation == "outputs":
            internal = {
                "run.log",
                "job.sh",
                ".exit-code",
                ".exit-code.tmp",
                "network.json",
                target.parameter_file,
            }
            internal.update(
                path.name for path in (run / key).iterdir() if path.name != "state.json"
            )
            files = (name.removeprefix("./") for name in machine.files(directory))
            permanent = {
                name: path
                for name, path in node.get("declared_outputs", {}).items()
                if not path.startswith(directory + "/")
            }
            response[key] = sorted(
                {
                    name
                    for name in files
                    if name not in internal
                    and name not in permanent
                    and not name.startswith("status/")
                }
                | set(permanent.values())
            )
        else:
            local_log = run / key / "run.log"
            data = (
                local_log.read_bytes()
                if local_log.is_file()
                else machine.get(directory, "run.log", required=False)
            )
            transport = run / key / "transport.log"
            if data is None and transport.is_file():
                data = transport.read_bytes()
            response[key] = (data or b"").decode(errors="replace")
    return {"run_id": run.name, operation: response}


def enqueue(run):
    with (run / "worker.log").open("wb") as log:
        subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "_worker", str(run)],
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    return status(run)


def artifact(run, qid, name, offset):
    outputs = inspect_run(run, "outputs", qid)["outputs"].get(qid, [])
    if name not in outputs:
        raise Error("unknown_output", "Select an output listed for this stage")
    stage = next(item for item in read(run / "plan.json")["stages"].values() if item["qid"] == qid)
    target = Target(**stage["target"])
    directory = Path(read(run / qid / "state.json")["directory"])
    path = directory / name
    root = str(directory)
    if Path(name).is_absolute():
        root = target.directory
        if target.workflow_directory and path.is_relative_to(target.workflow_directory):
            root = target.workflow_directory
    machine = Machine(target)
    python = "python3" if machine.ssh else sys.executable
    data = machine.call([python, "-c", READ_ARTIFACT, str(path), root, str(offset), str(ARTIFACT_CHUNK + 1)]).stdout
    return {
        "name": path.name,
        "media_type": mimetypes.guess_type(path.name)[0] or "application/octet-stream",
        "data": base64.b64encode(data[:ARTIFACT_CHUNK]).decode("ascii"),
        "next_offset": offset + ARTIFACT_CHUNK if len(data) > ARTIFACT_CHUNK else None,
    }


def public_status(state):
    result = {
        key: state[key]
        for key in ("run_id", "state", "error", "cancellation_requested", "source_run_id", "scheduling")
        if key in state
    }
    result["nodes"] = {
        node_id: {
            key: node[key]
            for key in ("qualified_id", "state", "error", "reused", "waiting_for")
            if key in node
        }
        for node_id, node in state["nodes"].items()
    }
    return result


def require_configuration(request, config):
    if request["configuration_digest"] != digest(values(config.tree)):
        raise Error("stale_configuration", "Refresh the active backend configuration")


def dispatch(request, path):
    operation = request["operation"]
    if operation == "configure":
        raise Error("unsupported_operation", "Edit the Python backend profile to configure installations")
    config = configuration(read(path))
    if operation in WORKFLOW_OPERATIONS:
        from workflow_archive import access_workflows
        require_configuration(request, config)
        return access_workflows(config, request)
    if operation == "describe":
        return registry_for(config)
    if operation == "migrate":
        return migrate(request["document"], config, registry_for(config))
    if operation == "artifact":
        return artifact(find_run(config, request["run_id"]), request["qualified_id"], request["name"], request["offset"])
    if operation == "replay":
        return public_status(enqueue(new_replay(find_run(config, request["run_id"]))))
    if operation in {"status", "logs", "outputs", "cancel", "pause", "resume"}:
        result = inspect_run(find_run(config, request["run_id"]), operation)
        return result if operation in {"logs", "outputs"} else public_status(result)
    require_configuration(request, config)
    registry = registry_for(config)
    if request["registry_digest"] != registry["__backend"]["registry_digest"]:
        raise Error("stale_registry", "Refresh the active backend registry")
    prepared = preparation(request["network"], config, registry)
    if operation == "validate":
        return {"valid": True}
    return public_status(enqueue(new_run(config, *prepared, None)))


def exchange(path):
    response = {"version": VERSION}
    try:
        request = json.load(sys.stdin)
        if isinstance(request, dict) and request.get("version") not in (None, VERSION):
            raise Error("incompatible_protocol", f"Expected execution protocol {VERSION}")
        check("execution-service#/$defs/request", request, "invalid_request")
        response["operation"] = request["operation"]
        response["result"] = dispatch(request, path)
        check("execution-service#/$defs/response", response, "invalid_response")
    except (Error, OSError, ValueError) as error:
        response.pop("result", None)
        response["error"] = diagnostic(error, "invalid_input")
    check("execution-service#/$defs/response", response, "invalid_response")
    sys.stdout.write(encode(response))
    return 0


def main():
    try:
        args = parser().parse_args()
        if args.operation == "_worker":
            result = worker(args.directory)
            return 0 if result["state"] == "succeeded" else 1
        if args.configuration is None:
            raise Error("invalid_arguments", "--configuration is required")
        if args.operation == "exchange":
            return exchange(args.configuration)
        config = configuration(read(args.configuration))
        if args.operation == "replay":
            result = enqueue(new_replay(find_run(config, args.run_id)))
        elif args.operation in {"status", "cancel", "pause", "resume", "logs", "outputs"}:
            result = inspect_run(
                find_run(config, args.run_id),
                args.operation,
                getattr(args, "qualified_id", None),
            )
        else:
            registry = registry_for(config)
            if args.operation == "register":
                write(args.registry_path, registry)
                return 0
            prepared = preparation(read(args.network), config, registry)
            if args.operation == "validate":
                result = {"valid": True}
            else:
                run = new_run(config, *prepared, args.touch_dir)
                if args.operation == "submit":
                    result = enqueue(run)
                else:
                    result = worker(run)
                    if result["state"] != "succeeded":
                        error = result.get(
                            "error",
                            {"code": "run_cancelled", "message": "Run cancelled"},
                        )
                        emit_error(error["code"], error["message"], run.name)
                        return 1
        sys.stdout.write(encode(result))
        return 0
    except Error as error:
        emit_error(error.code, str(error), qualified_id=error.qualified_id)
    except (OSError, ValueError) as error:
        emit_error("invalid_input", str(error))
    return 1


def emit_error(code, message, run_id=None, qualified_id=None):
    error = {"code": code, "message": message}
    if run_id is not None:
        error["run_id"] = run_id
    if qualified_id is not None:
        error["qualified_id"] = qualified_id
    print(json.dumps({"error": error}), file=sys.stderr)


if __name__ == "__main__":
    sys.exit(main())
